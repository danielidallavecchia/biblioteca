
<div class="login-body">

<div class="login-form">
    <div class="login-titulo">
        <p>Entrar na biblioteca</p>
    </div>

    <%= form_for login_path do %>
        <div class="login-campo">
            <%= label_tag :login, "Login:" %>
            <%= text_field_tag :login, params[:login], class:"login-input" %>
        </div>

        <div class="login-campo">
            <%= label_tag :senha, "Senha:" %>
            <%= password_field_tag :senha, params[:senha], class:"login-input" %>
        </div>

        <%= submit_tag "Entrar", class: "login-botao" %>
    <% end %>

    <%= link_to "Sem login? Cadastre-se", new_usuario_path, class: "login-link" %>
</div>

</div>

<div class="login-erro">
    <% if !flash.blank? %>
        <% flash.each do |tipo, msg| %>
            <% if tipo == :error %>
                <p class="msg-erro"><%= msg %></p>
            <% else %>
                <p class="msg-info"><%= msg %></p>
            <% end %>
        <% end %>
    <% end %> 
</div>
