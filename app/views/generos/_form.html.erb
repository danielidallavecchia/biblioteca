<%= form_for@genero, html: { class: "cartao" } do |f| %>
    <div class="cartao-corpo">

        <% if !@genero.id.blank? %>
             <!-- somente exibir no edit -->
            <div class="form-campo">
                <p class="form-texto-id">
                    <span>ID do registro:</span>
                    <span><%= @genero.id %></span>
                </p>
            </div>
        <% end %>

        <div class="campo">
            <p class="form-nome">
            <%= f.label :nome do %>
                Nome <span class="campo-required">*</span>
            <% end %>
            </p> 
            
            <%= f.text_field :nome, class:"form-input" %>
        </div>

    </div>

    <div class="cartao-rodape">
        <div>
        <%= link_to "Cancelar", generos_path, class: "btn" %>
        <%= f.submit(@genero.new_record? ? "Cadastrar" : "Salvar", class: "btn btn-primario") %>
        </div>

        <% if @genero.new_record? %>
        <div class="salvar-continuar">
            <%= f.submit "Salvar e continuar", name: "salvar_e_continuar", class: "btn botao-continuar" %>
        </div>
        <% end %>
    </div>

<%end%>
