
<div class="form-padrao">

    <%= form_for(@genero) do |f| %>

        <div class="form-campo">
            <p class="form-nome">
            <%= f.label :nome do %>
                Nome <span class="campo-required">*</span>
            <% end %>
            </p>
            
            <%= f.text_field :nome, class:"form-input" %>
        </div>

        <div class="form-botao">
            <%= link_to "Cancelar", generos_path, class: "form-botao-cancelar" %>
            <%= f.submit "Salvar", class: "form-botao-cadastrar" %>
        </div>
    
    <% end %>

</div>
