
<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar gênero</p>
        <p class="show-texto-subtitulo">Crie gêneros para vincular ao seu acervo</p>
    </div>
    
    <% if !@genero.errors.blank? %>
        <div class="erro-form">
            Erro:
            <ul>
                <% @genero.errors.full_messages.each do |erro| %>
                <li><%= erro %>.</li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= render "form" %>

</div>
