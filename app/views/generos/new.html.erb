
<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p>Cadastrar gênero</p>
        <p>Crie gêneros para vincular ao seu acervo</p>
    </div>

    <%= render "form" %>

    <% if @genero.errors.any? %>
    <div class="erro-form">
        Erro: <%= @genero.errors.full_messages.first %>
    </div>
    <% end %>
</div>
