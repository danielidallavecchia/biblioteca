

<% if !@livros_com_mesmo_autor.blank? %>
<div class="livro-sublista">

    <div class="titulo">Títulos do mesmo autor</div>

    <div class="livro-sublista-dados">
        <% @livros_com_mesmo_autor.each do |livro| %>
            <div class="livro-sublista-card">
                <div class="livro-sublista-capa-imagem">
                    <%= link_to info_livro_path(livro), class: "capa-link" do %>
                        <% if !livro.imagem_url.blank? %>
                            <%= image_tag livro.imagem_url, class: "livro-sublista-capa-imagem"%>
                        <% else %>
                            <span class="format-sem-capa">Sem capa</span>
                        <% end %>
                    <% end %>
                </div>

                <div>
                    <%= link_to "#{livro.titulo}", info_livro_path(livro),class: "livro-sublista-titulo" %>
                </div>
            </div>
        <% end %>    
    </div>

</div>
<% end %>
