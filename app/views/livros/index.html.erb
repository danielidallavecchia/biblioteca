
<div class="index-topo-padrao">
    <div class="index-titulo">
        <p class="index-texto-titulo">Livros</p>
        <p class="index-texto-subtitulo">Consulte os livros cadastrados e adicione novos ao seu acervo.</p>
    </div>

    <div class="index-botao">
        <%= link_to "Cadastrar livro", new_livro_path, class: "index-botao-novo" %>
    </div>
</div>

<div class="index-corpo-padrao">

    <div class="index-busca">
        <%= form_tag livros_path, method: :get do %>
            <%= text_field_tag :busca, params[:busca], placeholder: "Buscar por título, gênero ou autor", class: "index-busca-input" %>
            <%= hidden_field_tag :filtrar, params[:filtrar] %>
            <%= submit_tag "Buscar", name: nil, class: "index-busca-buscar" %>
            <%= link_to "Limpar", livros_path, class: "index-busca-limpar" %>
        <% end %>
        <span class="index-qtd-registros">
            <%= pluralize(@livros.length, "livro cadastrado", "livros cadastrados") %>
        </span>
    </div>

    <div>

        <% if @livros.blank? %>
            <p class="tabela-sem-registros">Sem registros encontrados.</p>
        <% else %>

            <div class="grade-livros">
                <% @livros.each do |livro| %>
                
                    <div class="card-livro">
                        <div class="capa">
                            <% if livro.imagem_url.present? %>
                                <%= link_to info_livro_path(livro) do %>
                                    <%= image_tag livro.imagem_url, class: "livro-capa-imagem", alt: "livro.titulo" %>
                                <% end %>
                            <% else %>
                                <%= link_to info_livro_path(livro) do %>
                                    <%= image_tag "", class: "livro-capa-imagem ", alt: "Sem capa" %>
                                <% end %>
                            <% end %>                        
                        </div>
                        
                        <div class="botao-acao">
                            <% if !livro.genero.blank? %>
                                <%= link_to "#{livro.genero.nome}", genero_path(livro.genero), class: "botao-text"%>
                            <% else %>
                                <span class="botao-text">(Sem gênero)</span>
                            <% end %>
                        </div>
                        
                        <div class="info-livro-textos">    
                            <strong class="text-livro">
                                <%= link_to livro.titulo, info_livro_path(livro), class: "text-livro" %>
                             </strong><br>

                            <% if !livro.autor.blank? %>
                                <%= link_to "#{livro.autor.nome}", autor_path(livro.autor), class: "text-autor" %>
                            <% else %>
                                <span class="text-autor-vazio">(Sem autor)</span>
                            <% end %>
                        </div>

                    </div>
                <% end %>
            </div>

        <% end %>
    </div>

</div>