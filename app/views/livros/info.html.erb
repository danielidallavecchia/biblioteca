<%= render "voltar" %>

<div class="livro-pagina">
  <div class="livro-card">
    <div class="livro-capa">
      <% if @livro.imagem_url.present? %>
        <%= image_tag @livro.imagem_url, class: "livro-capa-imagem", alt: @livro.titulo %>
      <% else %>
        <%= image_tag "", class: "livro-capa-imagem capa", alt: "Sem capa" %>
      <% end %>
    </div>

    <div class="coluna-conteudo">
      <h1 class="texto-titulo"><%= @livro.titulo %></h1>
      
      <div class="autor-genero">
          <% if @livro.genero.present? %>
          <div class="botao-acao">
            <%= link_to genero_path(@livro.genero), class: "botao-text" do %>
              <%= @livro.genero.nome %>
            <% end %>
          </div>
        <% end %>
        <p class="texto-autor">
          <% if @livro.autor.present? %>
            <%= link_to @livro.autor.nome, autor_path(@livro.autor) %>
          <% else %>
            <span class="texto-mutado">(Sem autor associado)</span>
          <% end %>
        </p>
      </div>

      <h2 class="texto-subtitulo">Sobre a obra</h2>
      
      <div class="text-sinopse">
        <%= @livro.sinopse %>
      </div>

      <div class="barra-livro">
        <div class="barra-item">
          <span class="barra-label">ID</span>
          <span class="barra-valor"><%= @livro.id %></span>
        </div>

        <div class="barra-item">
          <span class="barra-label">Ano de publicação</span>
          <span class="barra-valor">
            <% if @livro.ano_publicacao.blank? %>
                <span class="show-sem-dados">(Não informado)</span>
            <% else %>
                <%= @livro.ano_publicacao %>
            <% end %>
          </span>
        </div>

        <div class="barra-item">
          <span class="barra-label">Páginas</span>
          <span class="barra-valor"><%= @livro.qtd_paginas %></span>
        </div>

        <div class="barra-item">
          <span class="barra-label">Data de cadastro</span>
          <span class="barra-valor">
            <% if @livro.created_at.blank? %>
              <span class="show-sem-dados">(Não contém)</span>
            <% else %>
              <%= l(@livro.created_at, format: :default) %>
            <% end %>
          </span>
        </div>

        <div class="barra-item">
          <span class="barra-label">Emprestado</span>
          <span class="barra-valor">
            <%= @livro.emprestado?(@livro.id) ? "Sim" : "Não" %>
            <% if @livro.emprestado?(@livro.id) %>
              <%= link_to "(ver empréstimo)", emprestimo_path(@livro.emprestimo_atual_id(@livro.id)), class: "show-sem-dados" %>
            <% end %>
          </span>
        </div>
      </div>

      <div class="show-botoes">
        <%= link_to "Editar", edit_livro_path(@livro), class: "show-botao-editar" %>
        <%= link_to "Excluir", livro_path(@livro), data: { method: :delete, confirm: "Tem certeza?" }, class: "show-botao-excluir" %>
        
        <% if @livro.emprestado?(@livro.id) %>
          <%= link_to "Reservar", new_reserva_path(livro_id: @livro.id, usuario_id: session[:usuario_id]), class: "livros-botao-emprestar" %>
        <% else %>
          <%= link_to "Emprestar", new_emprestimo_path(livro_id: @livro.id, usuario_id: session[:usuario_id]), class: "livros-botao-emprestar" %>
        <% end %>
      </div>
      </div>
    </div>
  </div>

  <%= render "info_sublista" %>

</div>
