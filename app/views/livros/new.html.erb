
<div class="form-corpo-padrao">
    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar livro</p>
        <p class="show-texto-subtitulo">Adicione novos livros ao seu acervo</p>
    </div>
    
    <% if !@livro.errors.blank? %>
        <div class="erro-form">
            Erro:
            <ul>
                <% @livro.errors.full_messages.each do |erro| %>
                <li><%= erro %>.</li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= render "form" %>

</div>
