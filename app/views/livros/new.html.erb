
<div class="form-corpo-padrao">
    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar livro</p>
        <p class="show-texto-subtitulo">Crie livros para adicionar ao seu acervo</p>
    </div>

    <%= render "form" %>

    <% if @livro.errors.any? %>
    <div class="erro-form">
        Erro: <%= @livro.errors.full_messages.first %>
    </div>
    <% end %>
</div>
