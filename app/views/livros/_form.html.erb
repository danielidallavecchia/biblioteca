<%= form_for @livro, html: { class: "cartao", multipart: true } do |f| %>
    <div class="cartao-corpo">

        <% if !@livro.id.blank? %>
             <!-- somente exibir no edit -->
            <div class="form-campo">
                <p class="form-texto-id">
                    <span>ID do registro:</span>
                    <span><%= @livro.id %></span>
                </p>
            </div>
        <% end %>

        <div class="campo">
            <p class="form-nome">
                <%= f.label :titulo do %>
                    Título <span class="campo-required">*</span>
                <% end %>
            </p>
                
            <%= f.text_field :titulo, class:"form-input"  %>
        </div>

        <div class="linha">
            <div class="campo">
                <p class="form-nome">
                    <%= f.label :ano_publicacao do %>
                        Ano publicação  <span class="campo-required">*</span>
                    <% end %>
                </p>
                    
                <%= f.number_field :ano_publicacao, min: 1, class:"form-input"  %>
            </div>

            <div class="campo">
                <p class="form-nome">
                    <%= f.label :qtd_paginas do %>
                        Qtd. páginas <span class="campo-required">*</span>
                    <% end %>
                </p>
                    
                <%= f.number_field :qtd_paginas, min: 1, class:"form-input" %>
            </div>
        </div>

        <div class="campo">
            <p class="form-nome">
                <%= f.label :sinopse do %>
                    Sinopse <span class="campo-required">*</span>
                <% end %>
            </p>
                
            <%= f.text_field :sinopse, class:"form-input"  %>
        </div>

        <div class="livro-campos-lado">
            <div class="form-campo">
                <p class="form-nome">
                    <%= f.label :autor_id, "Autor" %>
                </p>

                <%= f.collection_select :autor_id, @autores, :id, :id_e_nome, {}, { class: "form-input" } %>
            </div>

            <div class="form-campo">
                <p class="form-nome">
                    <%= f.label :genero_id, "Gênero" %>
                </p>

                <%= f.collection_select :genero_id, @generos, :id, :id_e_nome, {}, { class: "form-input form" } %>
            </div>
        </div>

        <div class="imagem">
            <p class="form-nome">
                <%= f.label :imagem do %>
                    Capa do livro
                <% end %>
            </p>

            <%= f.file_field :imagem, class: "form-input" %>
        </div>

    </div>

    <div class="cartao-rodape">
        <div>
        <%= link_to "Cancelar", livros_path, class: "btn" %>
        <%= f.submit(@livro.new_record? ? "Cadastrar" : "Salvar", class: "btn btn-primario") %>
        </div>

        <% if @livro.new_record? %>
        <div class="salvar-continuar">
            <%= f.submit "Salvar e continuar", name: "salvar_e_continuar", class: "btn botao-continuar" %>
        </div>
        <% end %>
  </div>

<% end %>