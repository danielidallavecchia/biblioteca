<%= form_for @livro, html: { class: "cartao" } do |f| %>

    <div class="cartao-corpo">

        <% if !@livro.id.blank? %>
            <!-- somente exibir no edit -->
            <div>
                <p>
                    <span>ID do registro:</span>
                    <span><%= @livro.id %></span>
                </p>
            </div>
        <% end %>

        <div class="campo">
            <p class="form-nome">
                <%= f.label :titulo do %>
                    Título <span class="campo-required">*</span>
                <% end %>
            </p>
                
            <%= f.text_field :titulo, class:"form-input"  %>
        </div>

        <div class="linha">
            <div class="campo">
                <p class="form-nome">
                    <%= f.label :ano_publicacao do %>
                        Ano publicação <span class="campo-required">*</span>
                    <% end %>
                </p>
                    
                <%= f.number_field :ano_publicacao, min: 1, class:"form-input"  %>
            </div>

            <div class="campo">
                <p class="form-nome">
                    <%= f.label :qtd_paginas do %>
                        Qtd. páginas <span class="campo-required">*</span>
                    <% end %>
                </p>
                    
                <%= f.number_field :qtd_paginas, min: 1, class:"form-input" %>
            </div>
        </div>

        <div class="campo">
            <p class="form-nome">
                <%= f.label :sinopse do %>
                    Sinopse <span class="campo-required">*</span>
                <% end %>
            </p>
                
            <%= f.text_field :sinopse, class:"form-input"  %>
        </div>


        <div class="campo">
            <p class="form-nome">
                <%= f.label :autor_id, "Autor" %>
            </p>

            <%= f.collection_select :autor_id, @autores, :id, :id_e_nome, {}, { class: "form-input" } %>
        </div>

        <div class="campo">
            <p class="form-nome">
                <%= f.label :genero_id, "Gênero" %>
            </p>

            <%= f.collection_select :genero_id, @generos, :id, :id_e_nome, {}, { class: "form-input" } %>
        </div>
    </div>

    <div class="cartao-rodape">
        <%= link_to "Cancelar", livros_path, class: "btn" %>
        <%= f.submit "Salvar", class: "btn btn-primario" %>
    </div>
<% end %>