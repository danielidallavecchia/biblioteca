
<div class="index-topo-padrao">
    <div class="index-titulo">
        <p class="index-texto-titulo">Empréstimos</p>
        <p class="index-texto-subtitulo">Gerencia os empréstimos cadastrados e crie novos.</p>
    </div>

    <div class="index-botao">
        <%= link_to "Criar empréstimo", new_emprestimo_path, class: "index-botao-novo" %>
    </div>
</div>

<div class="index-corpo-padrao">
  
  <% if @tem_emprestimos %>

    <div class="emprestimo-filtros">
        <%= form_tag emprestimos_path(ativos: params[:ativos], busca: params[:busca], livro_id: params[:livro_id],
                usuario_id: params[:usuario_id], data_devolucao_inicio: params[:data_devolucao_inicio], 
                data_devolucao_fim: params[:data_devolucao_fim]
            ), method: :get do %>

            <div class="emprestimo-busca-topo">
                <!-- filtro de busca textual -->
                <div class="emprestimo-index-busca">
                    <%= text_field_tag :busca, params[:busca], placeholder: "Buscar por usuário ou livro", class: "index-busca-input" %>
                    <%= hidden_field_tag :filtrar, params[:filtrar] %>
                    <%= submit_tag "Buscar", name: nil, class: "index-busca-buscar" %>
                    <%= link_to "Limpar", emprestimos_path, class: "emprestimo-busca-limpar" %>
                </div>

                <span class="emprestimo-qtd-registros">
                    <%= pluralize(@emprestimos.length, "empréstimo cadastrado", "empréstimos cadastrados") %>
                </span>
            </div>

            <div class="emprestimo-busca-topo">
                <!-- filtro de ver somente abertos -->
                <div class="emprestimo-buscas">
                    <% if params[:ativos] == "true" || params[:livro_id] || params[:usuario_id] %>
                        <%= link_to "Ver todos", emprestimos_path(
                            busca: params[:busca], data_devolucao_inicio: params[:data_devolucao_inicio], data_devolucao_fim: params[:data_devolucao_fim]
                        ), class: "emprestimo-buscas-botao" %>

                    <% else %>
                        <%= link_to "Ver somente abertos", emprestimos_path(
                            ativos: true, busca: params[:busca], data_devolucao_inicio: params[:data_devolucao_inicio], data_devolucao_fim: params[:data_devolucao_fim]
                        ), class: "emprestimo-buscas-botao" %>
                    <% end %>

                    <% if params[:livro_id] %>
                        <span class="emprestimo-info-filtro">(Lista filtrada pelo Livro ID = <%= params[:livro_id] %>)</span>
                    <% end %>

                    <% if params[:usuario_id] %>
                        <span class="emprestimo-info-filtro">(lista filtrada pelo Usuário ID = <%= params[:usuario_id] %>)</span>
                    <% end %>
                </div>

                <!-- filtro de data -->
                <div class="emprestimo-filtro-data">
                    <% if !@erro.blank? %>
                        <div class="emprestimo-erro-index"><%= @erro %></div>
                    <% end %>

                    Devolvido entre 
                    <%= text_field_tag :data_devolucao_inicio, params[:data_devolucao_inicio], type: :date, class: "emprestimo-input-data" %>
                    e  
                    <%= text_field_tag :data_devolucao_fim, params[:data_devolucao_fim], type: :date, class: "emprestimo-input-data" %>
                </div>

            </div>

        <% end %>
    </div>
  
  <% end %>

    <div class="index-tabela">
        <% if @emprestimos.blank? %>
            <p class="tabela-sem-registros">Sem registros encontrados.</p>
        <% else %>
            <table>
                <thead>
                    <tr>
                        <th class="coluna-id">ID</th>
                        <th>Data cadastro</th>
                        <th>Data prevista devolução</th>
                        <th>Data devolução</th>
                        <th class="emprestimo-coluna-links">Livro</th>
                        <th class="emprestimo-coluna-links">Usuário</th>
                        <th class="emprestimo-coluna-status">Status</th>
                        <th class="emprestimo-coluna-acoes text-align-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% @emprestimos.each do |emprestimo| %>
                        <tr>
                            <td class="text-align-center"><%= emprestimo.id %></td>
                            <td><%= l(emprestimo.created_at, format: :default) %> </td>
                            <td><%= l(emprestimo.data_prevista_devolucao, format: :short) %> </td>
                            <td>
                                <% if emprestimo.data_devolucao.blank? %>
                                    —
                                <% else %>
                                    <%= l(emprestimo.data_devolucao, format: :default) %> 
                                <% end %>    
                            </td>
                            <td>
                                <% if emprestimo.livro_id.blank? %>
                                    —
                                <% else %>
                                    <%= link_to "##{emprestimo.livro_id} - #{emprestimo.livro.titulo}", info_livro_path(emprestimo.livro), class: "emprestimo-links" %>
                                <% end %>  
                            </td>
                            <td>
                                <% if emprestimo.usuario_id.blank? %>
                                    —
                                <% else %>
                                    <%= link_to "##{emprestimo.usuario_id} - #{emprestimo.usuario.nome}", usuario_path(emprestimo.usuario), class: "emprestimo-links" %>
                                <% end %>  
                            </td>
                            <td><%= emprestimo.status %></td>

                            <td class="text-align-center tabela-acoes">
                                <%= link_to "Ver registro", emprestimo_path(emprestimo), class: "tabela-botao-acao" %> 

                                <% if emprestimo.status != "ENCERRADO" %>
                                    | <%= link_to "Devolver", edit_emprestimo_path(emprestimo), class: "tabela-botao-acao" %>
                                <% else %>
                                    | <%= link_to "Excluir", emprestimo_path(emprestimo), method: :delete, data: { confirm: "Tem certeza?" }, class: "tabela-botao-acao" %>
                                <% end %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        <% end %>

    </div>

</div>