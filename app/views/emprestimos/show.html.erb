<div class="show-corpo-padrao">
    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Detalhes do empréstimo</p>
        <p class="show-texto-subtitulo">Consulte as informações do empréstimo.</p>
    </div>

    <div class="show-card">

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">ID</p>
                <p class="show-valor"><%= @emprestimo.id %> </p> 
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Data cadastro</p>
                <p class="show-valor">
                    <%= l(@emprestimo.created_at, format: :default) %>
                </p>
            </div>
        </div>

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Data prevista devolução</p>
                <p class="show-valor">
                    <% if @emprestimo.data_prevista_devolucao.blank? %>
                        <span class="show-sem-dados">(Não contém)</span>
                    <% else %>
                        <%= l(@emprestimo.data_prevista_devolucao, format: :short) %>
                    <% end %>
                </p>
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Data devolução</p>
                <p class="show-valor">
                    <% if @emprestimo.data_devolucao.blank? %>
                        <span class="show-sem-dados">(Não contém)</span>
                    <% else %>
                        <%= l(@emprestimo.data_devolucao, format: :default) %>
                    <% end %>
                </p>
            </div>
        </div>

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Livro</p>
                <p class="show-valor"> <%= link_to "##{@emprestimo.livro_id} - #{@emprestimo.livro.titulo}", livro_path(@emprestimo.livro), class: "emprestimo-links" %> </p>
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Usuário</p>
                <p class="show-valor"><%= link_to "##{@emprestimo.usuario_id} - #{@emprestimo.usuario.nome}", livro_path(@emprestimo.usuario), class: "emprestimo-links" %> </p>
            </div>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Status</p>
            <p class="show-valor">
                <%= @emprestimo.status %>
                <% if @emprestimo.status == "ATRASADO" %>
                    <span class="emprestimo-legenda-status">(relativo à data prevista de devolução)</span>
                <% end %>
            </p> 
        </div>
        
        <% if @emprestimo.status != "ENCERRADO" %>
            <div class="form-botao">
                <%= link_to "Devolver", edit_emprestimo_path(@emprestimo), class: "form-botao-cadastrar" %>
            </div>
        <% end %>

    </div>

</div>