<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar empréstimo</p>
        <p class="show-texto-subtitulo">Crie um novo empréstimo de um livro do acervo</p>
    </div>

    <%= render "form" %>

    <% if !@emprestimo.errors.blank? %>
    <div class="erro-form">
        Erro: <%= @emprestimo.errors.full_messages.first %>
    </div>
    <% end %>
</div>