<div class="margem">

    <div class="voltar-padrao">
        <%= link_to "⇦ Voltar", configuracao_path, class: "voltar-botao" %>
    </div>

    <div class="usuarios-titulo-lado">
        <div class="index-titulo">
            <p class="show-texto-titulo">Perfis de usuário</p>
        </div>

        <% if session[:usuario_id] == 1 %>
            <div class="usuarios-titulo-botao">
                <%= link_to "Cadastrar perfil", new_usuario_perfil_path, class: "usuarios-botao-ver-emprestimo" %>
            </div>
        <% end %>
    </div>

    <div class="index-corpo-padrao">
        <div class="index-tabela">
            <table>
                <thead>
                    <tr>
                        <th class="coluna-id-perfil">ID</th>
                        <th>Nome</th>
                        <th>Permite escrita</th>
                        <th>É perfil padrão</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% @usuario_perfis.each do |usuario_perfil| %>
                        <tr>
                            <td><%= usuario_perfil.id %></td>
                            <td><%= usuario_perfil.nome %> </td>
                            <td>
                                <% if usuario_perfil.pode_escrever %>
                                    <span class="usuario-perfil-sim">Sim</span>
                                <% else %>
                                    <span class="usuario-perfil-nao">Não</span> 
                                <% end %>
                            </td>
                            <td>
                                <% if @usuario_perfil_id_padrao == usuario_perfil.id %> 
                                    <span class="usuario-perfil-sim">Sim</span>
                                <% else %>
                                    <span class="usuario-perfil-nao">Não</span> 
                                <% end %>
                            </td>
                            <td>
                                <%= link_to "Ver registro", usuario_perfil_path(usuario_perfil), class: "tabela-botao-acao" %>

                                <% if session[:usuario_id] == 1 && @usuario_perfil_id_padrao == usuario_perfil.id %>
                                    | <%= link_to "Alterar padrão", altera_padrao_usuario_perfil_path, class: "tabela-botao-acao" %>
                                <% end %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>

</div>