<div class="margem">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Editar perfil de usuário</p>
        <p class="show-texto-subtitulo">Altere as informações do perfil</p>
    </div>

    <%= render "form" %>

    <% if !@usuario_perfil.errors.blank? %>
        <div class="erro-form">
            Erro: <%= @usuario_perfil.errors.full_messages.first %>
        </div>
    <% end %>

</div>
