<div class="margem">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Detalhes do perfil de usuário</p>
        <p class="show-texto-subtitulo">Gerencie os perfis de usuário da biblioteca.</p>
    </div>

    <div class="show-card">
        <div class="show-campo">
            <p class="show-rotulo">ID</p>
            <p class="show-valor"><%= @usuario_perfil.id %> </p> 
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Nome</p>
            <p class="show-valor"><%= @usuario_perfil.nome %> </p> 
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Permite escrita</p>
            <p class="show-valor"><%= @usuario_perfil.pode_escrever ? "Sim" : "Não" %></p> 
        </div>

        <% if session[:usuario_id] == 1 %> <!-- usuario 1 é o admin padrão -->
            <div class="show-botoes">
                <%= link_to "Editar", edit_usuario_perfil_path(@usuario_perfil), class: "show-botao-editar" %> 
                <%= link_to "Excluir", usuario_perfil_path(@usuario_perfil), data: { method: :delete, confirm: "Tem certeza?" }, class: "show-botao-excluir" %>
            </div>
        <% end %>
    </div>

    
    <% if !@erro.blank? %>
        <div class="erro-form">Erro: <%= @erro %></div>
    <% end %>

</div>
