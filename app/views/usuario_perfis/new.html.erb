<div class="margem">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar perfil de usuário</p>
        <p class="show-texto-subtitulo">Crie um novo perfil de usuário</p>
    </div>
    
    <% if !@usuario_perfil.errors.blank? %>
        <div class="erro-form">
            Erro:
            <ul>
                <% @usuario_perfil.errors.full_messages.each do |erro| %>
                <li><%= erro %>.</li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= render "form" %>

</div>
