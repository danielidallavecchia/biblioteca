
<div class="margem">
  <%= render "voltar" %>

    <div class="usuarios-titulo-lado">
      <div class="show-titulo">
        <p class="show-texto-titulo">Meu perfil</p>
        <p class="show-texto-subtitulo">Consulte as informações do usuário</p>
      </div>

      <div class="usuarios-titulo-botao">
        <%= link_to "Meus empréstimos", emprestimos_path, class: "usuarios-botao-ver-emprestimo" %>
        <%= link_to "Minhas reservas", reservas_path, class: "usuarios-botao-ver-emprestimo" %> 
      </div>
    </div>

  <% if @usuario.present? %>
  <div>
    <div class="principal">
      <div class="show-campo">
        <p class="show-rotulo">ID</p>
        <p class="show-valor"><%= @usuario.id %></p>
      </div>

      <div class="show-campo">
        <p class="show-rotulo">Nome</p>
        <p class="show-valor"><%= @usuario.nome %></p>
      </div>

      <div class="show-campo">
        <p class="show-rotulo">Login</p>
        <p class="show-valor"><%= @usuario.login %></p>
      </div>

      <div class="show-campo">
        <p class="show-rotulo">E-mail</p>
        <p class="show-valor"><%= @usuario.email %></p>
      </div>

      <div class="show-botoes">
        <%= link_to "Editar", edit_usuario_path(@usuario), class: "show-botao-editar" %>
        <%= link_to "Alterar senha", alterar_senha_perfil_path(@usuario), class: "show-botao-excluir" %>
      </div>
    </div>
  </div>
  <% else %>
    <p>Perfil não encontrado.</p>
  <% end %>
</div>