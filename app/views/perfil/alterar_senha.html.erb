<div class="margem">
  <%= render "voltar" %>

  <div class="show-titulo">
    <p class="show-texto-titulo">Alterar senha</p>
    <p class="show-texto-subtitulo">Informe sua senha atual e escolha uma nova</p>
  </div>

  <%= form_tag atualizar_senha_perfil_path, method: :put, class: "cartao" do %>
    <div class="cartao-corpo">
    
      <div class="campo">
        <p class="form-nome">
          <%= label_tag :senha_atual do %>Senha atual <span class="campo-required">*</span><% end %>
        </p>
        <%= password_field_tag :senha_atual, nil, class: "form-input" %>
      </div>

      <div class="linha">
        <div class="campo">
          <p class="form-nome">
            <%= label_tag :nova_senha do %>Nova senha <span class="campo-required">*</span><% end %>
          </p>
          <%= password_field_tag :nova_senha, nil, class: "form-input" %>
        </div>

        <div class="campo">
          <p class="form-nome">
            <%= label_tag :confirmacao_senha do %>Confirmar senha <span class="campo-required">*</span><% end %>
          </p>
          <%= password_field_tag :confirmacao_senha, nil, class: "form-input" %>
        </div>
      </div>

    </div>

    <div class="cartao-rodape">
      <%= link_to "Cancelar", perfil_path, class: "btn" %>
      <%= submit_tag "Salvar", class: "btn btn-primario" %>
    </div>
  <% end %>

  <% if !@erro.blank? %>
    <div class="erro-form"><%= @erro %></div>
  <% end %>

</div>
