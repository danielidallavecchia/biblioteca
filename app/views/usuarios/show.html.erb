<div class="show-corpo-padrao">

    <%= render "voltar" %>

    <div class="usuarios-titulo-lado">
        <div class="show-titulo">
            <p class="show-texto-titulo">Detalhes do usuário</p>
            <p class="show-texto-subtitulo">Consulte as informações do usuário cadastrado</p>
        </div>

        <div class="usuarios-titulo-botao">
            <%= link_to "Ver empréstimos", emprestimos_path(usuario_id: @usuario.id), class: "usuarios-botao-ver-emprestimo" %> 
        </div>
    </div>

    <div class="show-card">
        <div class="show-campo">
            <p class="show-rotulo">ID</p>
            <p class="show-valor"><%= @usuario.id %> </p> 
        </div>

        <div class="usuario-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Nome</p>
                <p class="show-valor"><%= @usuario.nome %> </p>
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Login</p>
                <p class="show-valor"><%= @usuario.login %> </p>
            </div>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">E-mail</p>
            <p class="show-valor"><%= @usuario.email %> </p>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Perfil</p>
            <p class="show-valor">
                <% if @usuario.id == 1 %> 
                    Sysadmin <!-- perfil do sysadmin é sempre esse -->
                <% else %>
                    <%= @usuario.usuario_perfil.nome %> 
                <% end %>
            </p>
        </div>

         <div class="show-campo">
            <p class="show-rotulo">Cadastro</p>
            <p class="show-valor"><%= @usuario.created_at.strftime("%d/%m/%Y %H:%M") %></p>
        </div>

        <% if pode_escrever? %>
            <div class="show-botoes">
                <% if @usuario.id == 1 && session[:usuario_id] == 1 %> <!-- somente usuario 1 pode editar ele mesmo -->
                    <%= link_to "Editar", edit_usuario_path(@usuario), class: "show-botao-editar" %>
                <% end %>

                <% if session[:usuario_id] != @usuario.id && @usuario.id != 1 %>
                    <%= link_to "Excluir", usuario_path(@usuario), data: { method: :delete, confirm: "Tem certeza?" }, class: "show-botao-excluir" %>
                <% end %>
            </div>
        <% end %>
    </div>
</div>