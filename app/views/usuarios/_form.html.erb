<%= form_for @usuario, html: { class: "cartao" } do |f| %>
  <div class="cartao-corpo">
  
    <div class="campo">
    <p class="form-nome">
      <%= f.label :nome do %>Nome <span class="campo-required">*</span><% end %>
      </p>
      <%= f.text_field :nome, class:"form-input"%>
    </div>

    <div class="linha">
      <div class="campo">
      <p class="form-nome">
        <%= f.label :login do %>Login <span class="campo-required">*</span><% end %>
      </p>
        <%= f.text_field :login, class:"form-input" %>
      </div>
      <div class="campo">
      <p class="form-nome">
        <%= f.label :email do %>E-mail <span class="campo-required">*</span><% end %>
      </p>
        <%= f.text_field :email, class:"form-input" %>
      </div>
    </div>

    <% if @usuario.new_record? %>
    <div class="campo">
    <p class="form-nome">
      <%= f.label :senha do %>
        Senha <span class="campo-required">*</span>
      <% end %>
    </p>
    <%= f.password_field :senha, class: "form-input" %>
  </div>
<% end %>
  </div>

  <div class="cartao-rodape">
    <%= link_to "Cancelar", usuarios_path, class: "btn" %>
    <%= f.submit(@usuario.new_record? ? "Cadastrar" : "Salvar", class: "btn btn-primario") %>
  </div>
<% end %>