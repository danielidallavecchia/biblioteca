<%= form_for @usuario, html: { class: "cartao" } do |f| %>
  <div class="cartao-corpo">
    <% if @usuario.errors.any? %>
      <div class="erro-form">
        Erro: <%= @usuario.errors.full_messages.first %>
      </div>
    <% end %>

    <div class="campo">
      <%= f.label :nome do %>Nome <span class="campo-required">*</span><% end %>
      <%= f.text_field :nome %>
    </div>

    <div class="linha">
      <div class="campo">
        <%= f.label :login do %>Login <span class="campo-required">*</span><% end %>
        <%= f.text_field :login %>
      </div>
      <div class="campo">
        <%= f.label :email do %>E-mail <span class="campo-required">*</span><% end %>
        <%= f.text_field :email %>
      </div>
    </div>

    <div class="campo">
      <%= f.label :senha do %>
        Senha <% if @usuario.new_record? %><span class="campo-required">*</span><% end %>
      <% end %>
      <%= f.password_field :senha,
            placeholder: (@usuario.persisted? ? "Deixe em branco para manter a senha atual" : nil) %>
    </div>
  </div>

  <div class="cartao-rodape">
    <%= link_to "Cancelar", usuarios_path, class: "btn" %>
    <%= f.submit(@usuario.new_record? ? "Cadastrar" : "Salvar", class: "btn btn-primario") %>
  </div>
<% end %>