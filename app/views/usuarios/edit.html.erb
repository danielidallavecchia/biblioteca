<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Editar usuário</p>
        <p class="show-texto-subtitulo">Altere as informações do usuário</p>
    </div>


    <%= render 'form' %>
    
    <% if @usuario.errors.any? %>
    <div class="erro-form">
        Erro: <%= @usuario.errors.full_messages.first %>
    </div>
    <% end %>
</div>
