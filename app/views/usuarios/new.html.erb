<div class="form-corpo-padrao">

<%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar usuário</p>
        <p class="show-texto-subtitulo">Cadastre novos usuários para se conectar ao sistema</p>
    </div>

    <%= render 'form' %>

    <% if @usuario.errors.any? %>
    <div class="erro-form">
        Erro: <%= @usuario.errors.full_messages.first %>
    </div>
    <% end %>
</div>