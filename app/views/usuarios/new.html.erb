
<div class="form-corpo-padrao">

    <div class="show-titulo">
        <h1>Cadastrar usuário</h1>
        <p>Cadastre novos usuários para se conectar ao sistema</p>
    </div>

    <%= render 'form' %>


    <% if @usuario.errors.any? %>
    <div class="erro-form">
        Erro: <%= @usuario.errors.full_messages.first %>
    </div>
    <% end %>
</div>