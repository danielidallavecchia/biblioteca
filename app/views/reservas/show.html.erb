<div class="show-corpo-padrao">
    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Detalhes da reserva</p>
        <p class="show-texto-subtitulo">Consulte as informações da reserva cadastrada.</p>
    </div>

    <div class="show-card">

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">ID</p>
                <p class="show-valor"><%= @reserva.id %></p> 
            </div>

            <div class="show-campo">
                <% if !@reserva.posicao.blank? %>
                    <p class="show-rotulo">Posição</p>
                    <p class="show-valor"><%= @reserva.posicao %> / <%= @reservas_por_livro.length %> </p> 
                <% else %>
                    <% if !@emprestimo_origem_id.blank? %>
                        <div class="show-campo">
                            <p class="show-rotulo">Empréstimo originado</p>
                            <p class="show-valor">
                                <%= link_to "##{@emprestimo_origem_id} (ver empréstimo)", emprestimo_path(@emprestimo_origem_id), class: "reserva-links" %>
                            </p> 
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Livro</p>
                <p class="show-valor"> <%= link_to "##{@reserva.livro_id} - #{@reserva.livro.titulo}", info_livro_path(@reserva.livro), class: "reserva-links" %> </p>
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Usuário</p>
                <p class="show-valor"><%= link_to "##{@reserva.usuario_id} - #{@reserva.usuario.nome}", usuario_path(@reserva.usuario), class: "reserva-links" %> </p>
            </div>
        </div>

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Data reserva</p>
                <p class="show-valor"><%= l(@reserva.data_reserva, format: :default) %></p> 
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Data expiração</p>
                <p class="show-valor">
                    <% if @reserva.data_expiracao.blank? %>
                        —
                    <% else %>
                        <%= l(@reserva.data_expiracao, format: :default) %>
                    <% end %>
                </p> 
            </div>
        </div>

        <div class="emprestimo-campos-lado">
            <div class="show-campo">
                <p class="show-rotulo">Data cadastro</p>
                <p class="show-valor"><%= l(@reserva.created_at, format: :default) %></p> 
            </div>

            <div class="show-campo">
                <p class="show-rotulo">Status</p>
                <p class="show-valor"><%= @reserva.status %></p> 
            </div>
        </div>

        <% if pode_escrever? %>
            <div class="show-botoes">
                <%= link_to "Excluir", reserva_path(@reserva), data: { method: :delete, confirm: "Tem certeza?" }, class: "show-botao-excluir" %>
            </div>
        <% end %>
        
    </div>
</div>