<%= form_for @reserva, html: { class: "cartao" } do |f| %>
    <div class="cartao-corpo">
        <div class="campo">
            <p class="form-nome-maior">
            <%= f.label :data_reserva do %>
                Data início <span class="campo-required">*</span>
            <% end %>
            </p>

            <% if @reserva.data_reserva.blank? %>
                <%= f.text_field :data_reserva, type: "date", class:"form-input" %>
            <% else %>
                <%= f.text_field :data_reserva, type: "date", value: l(@reserva.data_reserva, format: :date), class:"form-input" %>
            <% end %>
        </div>

        <% if pode_escrever? %>
            <div class="form-campo">
                <p class="form-nome">
                    <%= f.label :usuario_id, "Usuário" %>
                </p>

                <%= f.collection_select :usuario_id, @usuarios, :id, :id_e_nome, {}, { class: "form-input" } %>
            </div>
        <% end %>

        <div class="form-campo">
            <p class="form-nome">
                <%= f.label :livro_id, "Livro" %>
            </p>

            <%= f.collection_select :livro_id, @livros, :id, :id_e_titulo, {}, { class: "form-input" } %>
        </div>
    </div>

    <div class="cartao-rodape">
        <%= link_to "Cancelar", reservas_path, class: "btn" %>
        <%= f.submit "Salvar", class: "btn btn-primario" %>
    </div>
<% end %>