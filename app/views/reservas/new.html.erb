<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Cadastrar reserva</p>
        <p class="show-texto-subtitulo">Crie uma nova reserva para um livro do acervo</p>
    </div>

    <%= render "form" %>

    <% if !@reserva.errors.blank? %>
    <div class="erro-form">
        Erro: <%= @reserva.errors.full_messages.first %>
    </div>
    <% end %>
</div>