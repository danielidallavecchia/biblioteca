<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">
            <% if pode_escrever? %>
                Cadastrar reserva
            <% else %>
                Criar minha reserva
            <% end %>
        </p>
    </div>
    
    <% if !@reserva.errors.blank? %>
        <div class="erro-form">
            Erro:
            <ul>
                <% @reserva.errors.full_messages.each do |erro| %>
                <li><%= erro %>.</li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= render "form" %>

</div>