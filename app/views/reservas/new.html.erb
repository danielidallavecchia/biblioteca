<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">
            <% if pode_escrever? %>
                Cadastrar reserva
            <% else %>
                Criar minha reserva
            <% end %>
        </p>
    </div>

    <%= render "form" %>

    <% if !@reserva.errors.blank? %>
    <div class="erro-form">
        Erro: <%= @reserva.errors.full_messages.first %>
    </div>
    <% end %>
</div>