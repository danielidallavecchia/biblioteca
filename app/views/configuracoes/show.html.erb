
<div class="margem">
    <%= render "voltar" %>

    <div class="usuarios-titulo-lado">
        <div class="show-titulo">
            <p class="show-texto-titulo">Configurações</p>
            <p class="show-texto-subtitulo">
                Consulte <%= "e edite" if pode_escrever? %> as configurações da biblioteca.
            </p>
        </div>

        <% if pode_escrever? %>
        <div class="cfg-perfil">
            <% if session[:usuario_id] == 1 %>
                <%= link_to "Configurar perfis de usuários", usuario_perfis_path, class: "cfg-perfil-botao" %>
            <% else %>
                <%= link_to "Ver perfis de usuários", usuario_perfis_path, class: "cfg-perfil-botao" %>
            <% end %>
        </div>
        <% end %>
    </div>

    <div class="show-card">
        <div class="show-campo">
            <p class="show-rotulo">Reserva automática</p>
            <p class="show-valor">
                <%= @configuracao.reserva_automatica ? "Sim" : "Não" %> 
            </p> 
        </div>

        <% if pode_escrever? %>
            <div class="cfg-botoes">
                <%= link_to "Editar", edit_configuracao_path(@configuracao), class: "show-botao-editar" %> 
            </div>
        <% end %>
    </div>
</div>