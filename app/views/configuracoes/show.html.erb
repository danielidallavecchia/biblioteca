
<div class="margem">
    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Configurações</p>
        <p class="show-texto-subtitulo">Consulte e edite as configurações da sua biblioteca.</p>
    </div>

    <div class="show-card">
        <div class="show-campo">
            <p class="show-rotulo">Reserva automática</p>
            <p class="show-valor">
                <%= @configuracao.reserva_automatica ? "Sim" : "Não" %> 
            </p> 
        </div>

        <div class="cfg-botoes">
            <%= link_to "Editar", edit_configuracao_path(@configuracao), class: "show-botao-editar" %> 
        </div>
    </div>
</div>