
<div class="margem">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Editar configurações</p>
        <p class="show-texto-subtitulo">Altere as configurações da bibliteca</p>
    </div>

    <%= render "form" %>

    <% if !@configuracao.errors.blank? %>
    <div class="erro-form">
        Erro: <%= @configuracao.errors.full_messages.first %>
    </div>
    <% end %>

</div>
