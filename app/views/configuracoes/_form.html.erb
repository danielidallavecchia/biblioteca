
<%= form_for @configuracao, html: { class: "cartao" } do |f| %>
    <div class="cartao-corpo">
        <div class="form-campo">
            <p class="form-nome">
                <%= f.label :reserva_automatica, "Reserva automática" %>
            </p>
            <div class="cfg-reserva-auto">
                <%= f.check_box :reserva_automatica, class:"cfg-checkbox", onclick: "muda_texto_configuracao(#{@configuracao.reserva_automatica})" %>
                <span class="cfg-texto-reserva" id="cfg-texto-reserva">
                    <% if @configuracao.reserva_automatica %>
                        (está ativo)
                    <% else %>
                        (está inativo)
                    <% end %>
                </span>
            </div>
        </div>
    </div>

    <div class="cartao-rodape">
        <%= link_to "Cancelar", configuracao_path, class: "btn" %>
        <%= f.submit "Salvar", class: "btn btn-primario" %>
    </div>
<% end %>
