                    <!-- <% if @configuracao.reserva_automatica %> -->
                        <!-- (está ativo) -->
                    <!-- <% else %> -->
                        <!-- (está inativo) -->
                   <!-- <% end %> -->
                <!-- </span> -->
            <!-- </div> -->

            <div class="cfg-reserva-auto">
                <%= f.radio_button :reserva_automatica, true, class: "cfg-input" %>
