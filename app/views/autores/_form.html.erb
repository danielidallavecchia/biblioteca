
<%= form_for( @autor, html: { class: "cartao" }, url: (@autor.new_record? ? autores_path : autor_path(@autor)) ) do |f| %>
    <div class="cartao-corpo">

        <% if !@autor.id.blank? %>
            <!-- somente exibir no edit -->
            <div class="form-campo">
                <p class="form-texto-id">
                    <span>ID do registro:</span>
                    <span><%= @autor.id %></span>
                </p>
            </div>
        <% end %>

        <div class="form-campo">
            <p class="form-nome">
            <%= f.label :nome do %>
                Nome <span class="campo-required">*</span>
            <% end %>
            </p>
            
            <%= f.text_field :nome, class:"form-input" %>
        </div>
    </div>

    <div class="cartao-rodape">
        <%= link_to "Cancelar", autores_path, class: "btn" %>
        <%= f.submit "Salvar", class: "btn btn-primario" %>
    </div>
<% end %>
