
<%= form_for( @autor, html: { class: "cartao" }, url: (@autor.new_record? ? autores_path : autor_path(@autor)) ) do |f| %>
    <div class="cartao-corpo">

        <% if !@autor.id.blank? %>
            <!-- somente exibir no edit -->
            <div class="form-campo">
                <p class="form-texto-id">
                    <span>ID do registro:</span>
                    <span><%= @autor.id %></span>
                </p>
            </div>
        <% end %>

        <div class="form-campo">
            <p class="form-nome">
            <%= f.label :nome do %>
                Nome <span class="campo-required">*</span>
            <% end %>
            </p>
            
            <%= f.text_field :nome, class:"form-input" %>
        </div>

        <div class="form-campo">
            <p class="form-nome">
            <%= f.label :data_nasc do %>
                Data nascimento <span class="campo-required">*</span>
            <% end %>
            </p>
            
            <%= f.text_field :data_nasc, type: "date", class:"form-input" %>
        </div>

        <div class="form-campo">
            <p class="form-nome">
            <%= f.label :data_obito do %>
                Data óbito
            <% end %>
            </p>
            
            <%= f.text_field :data_obito, type: "date", class:"form-input" %>
        </div>

        <div class="form-botao">
            <%= link_to "Cancelar", autores_path, class: "form-botao-cancelar" %>
            <%= f.submit "Salvar", class: "form-botao-cadastrar" %>
        </div>
    
    <% end %>

</div>
