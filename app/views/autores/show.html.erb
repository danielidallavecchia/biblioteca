
<div class="show-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Detalhes do autor</p>
        <p class="show-texto-subtitulo">Consulte as informações do autor cadastrado no seu acervo.</p>
    </div>

    <div class="show-card">
        <div class="show-campo">
            <p class="show-rotulo">ID</p>
            <p class="show-valor"><%= @autor.id %> </p> 
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Nome</p>
            <p class="show-valor"><%= @autor.nome %> </p>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Data nascimento</p>
            <p class="show-valor"><%= l(@autor.data_nasc, format: :default) %></p>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Data óbito</p>
            <p class="show-valor">
                <% if @autor.data_obito.blank? %>
                    <span class="show-sem-dados">(Não contém)</span>
                <% else %>
                    <%= l(@autor.data_obito, format: :default) %>
                <% end %>
            </p>
        </div>

        <div class="show-campo">
            <p class="show-rotulo">Cadastro</p>
            <p class="show-valor">
                <% if @autor.data_obito.blank? %>
                    <span class="show-sem-dados">(Não contém)</span>
                <% else %>
                    <%= l(@autor.data_obito, format: :default) %>
                <% end %>
            </p>
        </div>

        <div class="show-botoes">
            <%= link_to "Editar", edit_autor_path(@autor), class: "show-botao-editar" %> 
            <%= link_to "Excluir", autor_path(@autor), data: { method: :delete, confirm: "Tem certeza?" }, class: "show-botao-excluir" %>
        </div>
    </div>

</div>
