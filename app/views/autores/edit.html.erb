
<div class="form-corpo-padrao">

    <%= render "voltar" %>

    <div class="show-titulo">
        <p class="show-texto-titulo">Editar autor</p>
        <p class="show-texto-subtitulo">Altere as informações do autor cadastrado</p>
    </div>

    <%= render "form" %>

    <% if @autor.errors.any? %>
    <div class="erro-form">
        Erro: <%= @autor.errors.full_messages.first %>
    </div>
    <% end %>
</div>
