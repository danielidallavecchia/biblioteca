<!DOCTYPE html>
<html>
<head>
    <title>Biblioteca</title>
    <%= stylesheet_link_tag "application", :media => "all" %>
    <%= csrf_meta_tags %>   
    <%= javascript_include_tag "application" %>
</head>
<body>
    <header class="topo">
        <div class="topo-conteudo">
            <div class="topo-linha">
                <div class="topo-marca">
                <%= link_to livros_path, class: "topo-nome" do %>
                    <%= image_tag "livro.png", class: "topo-logo" %>
                    <span>Biblioteca</span>
                <% end %>
                </div>

                <div class="topo-perfil">
                    <% if logado? %>
                        <%= link_to perfil_path, class: 'topo-botao' do %>
                            Meu perfil
                        <% end %>
                        <%= link_to "Sair", logout_path, class: "topo-botao" %> 
                    <% end %>
                </div>
            </div>

            <nav class="topo-menu">
            <% if logado? %>
                <%= link_to 'Livros',      livros_path,      class: ('ativo' if controller_name == 'livros') %>
                <%= link_to 'Autores',     autores_path,     class: ('ativo' if controller_name == 'autores') %>
                <%= link_to 'Gêneros',     generos_path,     class: ('ativo' if controller_name == 'generos') %>
                <%= link_to 'Usuários',    usuarios_path,    class: ('ativo' if controller_name == 'usuarios') %>
                <%= link_to 'Empréstimos', emprestimos_path, class: ('ativo' if controller_name == 'emprestimos') %>
                <%= link_to 'Reservas',    reservas_path,    class: ('ativo' if controller_name == 'reservas') %>
            <% end %>
            </nav>
        </div>
    </header>

    <div class="body-corpo">
        <%= yield %>
    </div>
</body>
</html>