<!DOCTYPE html>
<html>
<head>
    <title>Biblioteca</title>
    <%= stylesheet_link_tag "application", :media => "all" %>
    <%= csrf_meta_tags %>

    <script src="<%= javascript_path 'application' %>"></script>

</head>
<body>
    <header>
        <div>
            <div>Biblioteca</div>
            <div>Meu perfil</div>
        </div>
        <nav>
            <%= link_to 'Livros', '#' %>
            <%= link_to 'Autores', autores_path %>
            <%= link_to 'Gêneros', generos_path %>
            <%= link_to 'Usuários', usuarios_path %>
            <%= link_to 'Empréstimos', '#' %>
            <%= link_to 'Reservas', '#' %>
        </nav>
    </header>
  
    <div class="body-corpo">
      <%= yield %>
    </div>
</body>
</html>